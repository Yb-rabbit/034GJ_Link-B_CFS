  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm3_05
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u201C\u4F60\u597D\uFF0C\u4E86\u89E3\u4E00\u4E0B\u3002\u201D"
    audioClip: {fileID: 8300000, guid: 19356e696c4cec8448a36883398475d2, type: 3}
  - text: "\u6709\u4EBA\u5728\u53D1\u4F20\u5355\uFF0C\u4ED6\u4E0D\u7BA1\u8FC7\u8DEF\u7684\u4EBA\u5728\u505A\u4EC0\u4E48\uFF0C\u603B\u662F\u5F80\u6BCF\u4E00\u4E2A\u4EBA\u624B\u91CC\u585E\u3002"
    audioClip: {fileID: 0}
  - text: "\u4ED6\u63A5\u8FC7\u4E00\u5F20\uFF0C\u770B\u4E86\u4E00\u773C\uFF0C\u5E76\u6CA1\u770B\u61C2\u4F20\u5355\u4E0A\u5199\u4E86\u4EC0\u4E48\u3002\u987A\u624B\u53E0\u4E86\u4E24\u4E0B\uFF0C\u63E3\u8FDB\u515C\u91CC\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u4EC0\u4E48\u4E1C\u897F\uFF1F\u201D\u5979\u95EE\u3002"
    audioClip: {fileID: 8300000, guid: 4bc937e1a4089df4c86b01274aa1feb4, type: 3}
  - text: "\u201C\u4E0D\u77E5\u9053\u3002\u201D\u4ED6\u8BF4\uFF0C\u201C\u4F46\u662F\u53D1\u7ED9\u6211\u4E86\uFF0C\u6211\u8FD8\u662F\u6536\u4E0B\u5427\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u5979\u53C8\u7B11\u4E86\uFF0C\u8FD9\u56DE\u7B11\u51FA\u4E86\u58F0\u3002"
    audioClip: {fileID: 0}
  - text: "\u5979\u633D\u7D27\u4E86\u4ED6\u7684\u80F3\u818A\uFF0C\u5F80\u524D\u8D70\u3002"
    audioClip: {fileID: 0}
