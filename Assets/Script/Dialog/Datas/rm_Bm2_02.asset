%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm2_02
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u201C\u4F60\u597D\uFF01\u6211\u80FD\u8DDF\u4F60\u4E00\u8D77\u51FA\u53BB\u73A9\u5417\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: 31e002b8e7bf87b4881c90e9d2b535a2, type: 3}
  - text: "\u201C\u5C0F\u670B\u25A0\uFF0C\u53EF\u4E0D\u80FD\u8FD9\u6837\u4E71\u8DD1\u5662\u2026\u2026\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u54CE\uFF01\u5B9E\u5728\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u5BB6\u5B69\u5B50\u6321\u60A8\u7684\u8DEF\u4E86\u3002\u201D"
    audioClip: {fileID: 8300000, guid: e7713a2b336549e47b1ce1606f105b87, type: 3}
  - text: "\u201C\u6CA1\u5173\u7CFB\uFF0C\u6211\u4E5F\u624D\u521A\u51FA\u25A0\u4E0D\u4E45\u2026\u2026\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u4E0D\u561B\u4E0D\u561B\uFF0C\u4F26\u5BB6\u60F3\u8DDF\u53D4\u53D4\u4E00\u8D77\u51FA\u53BB\u561B\u3002\u201D"
    audioClip: {fileID: 8300000, guid: 50d17691263265c41b70aca2d2cd01b2, type: 3}
  - text: "\u201C\u522B\u95F9\u5566\uFF0C\u5148\u8BA9\u53D4\u53D4\u8FC7\u53BB\uFF0C\u53D4\u53D4\u7ED9\u4F60\u5E26\u7CD6\u56DE\u6765\u600E\u4E48\u6837\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: 28ed65e0c6bb56e42a317301e59d57a8, type: 3}
  - text: "\u6211\u5B9E\u5728\u65E0\u6CD5\u8FA8\u8BA4\u8FD9\u4F4D\u5973\u58EB\u7684\u8868\u60C5\uFF0C\u53EA\u80FD\u5C34\u5C2C\u5730\u5411\u90A3\u4F4D\u5973\u5B69\u70B9\u70B9\u5934\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u8981\u542C\u8BDD\u5662\uFF0C\u25A0\u25A0\u56DE\u6765\u80AF\u5B9A\u7ED9\u4F60\u5E26\u7CD6\u679C\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u771F\u7684\u561B\u2026\u2026\u4E0D\u8BB8\u9A97\u6211\u5662\uFF01\u201D"
    audioClip: {fileID: 8300000, guid: 967bf91906eb0134284149aa438ecdaf, type: 3}
  - text: "\u201C\u5F53\u7136\u662F\u771F\u7684\u5566\uFF0C\u4E56\uFF0C\u6211\u4EEC\u5148\u53BB\u627E\u963F\u59E8\u62FF\u836F\u5403\u3002\u201D"
    audioClip: {fileID: 8300000, guid: 65a503ce73d4955448d4f829a81b5672, type: 3}
  - text: "\u201C\u53D4\u53D4\u518D\u89C1\uFF01\u201D"
    audioClip: {fileID: 8300000, guid: 952d7e361eac02d4ab36aeb5744ace52, type: 3}
  - text: "\u90A3\u5973\u5B69\u4ECE\u6211\u7684\u8EAB\u8FB9\u8DEF\u8FC7\u65F6\uFF0C\u5934\u9876\u8E6D\u5230\u6211\u7684\u624B\u80CC\u3002"
    audioClip: {fileID: 0}
  - text: "\u2026\u2026\u6CA1\u6709\u5934\u53D1\uFF0C\u4F3C\u4E4E\u624D\u521A\u5243\u5B8C\u4E0D\u4E45\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u60A8\u8BF7\u6162\u8D70\uFF0C\u6253\u6270\u60A8\u771F\u662F\u4E0D\u597D\u610F\u601D\u2026\u2026\u201D"
    audioClip: {fileID: 8300000, guid: e11795d8947865140b14ac4a4c67853c, type: 3}
  - text: "\u201C\u6CA1\u5173\u25A0\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u5979\u4EEC\u8D70\u540E\uFF0C\u957F\u5ECA\u4E0A\u53D8\u5F97\u5B89\u9759\uFF0C\u5374\u53C8\u88AB\u533B\u7597\u8BBE\u5907\u8FD0\u8F6C\u7684\u767D\u566A\u58F0\u586B\u6EE1\u3002"
    audioClip: {fileID: 0}
  - text: "\u7EE7\u7EED\u5F80\u524D\u8D70\u5427\u3002"
    audioClip: {fileID: 8300000, guid: 04d8a4f8182c4224ab71b46fd46877da, type: 3}
  - text: "\u4E0D\u77E5\u9053\u8FD9\u6837\u5BF9\u6211\u6765\u8BF4\u662F\u597D\u662F\u574F\u3002"
    audioClip: {fileID: 0}
