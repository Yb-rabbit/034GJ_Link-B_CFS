  m_Name: rm_Blur_01
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u96E8\u53D8\u5927\u4E86\u3002\u58F0\u97F3\u4ECE\u70B9\u53D8\u6210\u7EBF\uFF0C\u4ECE\u7EBF\u53D8\u6210\u9762\uFF0C\u4ECE\u9762\u53D8\u6210\u5305\u56F4\u4ED6\u7684\u3001\u6D41\u52A8\u7684\u7A7A\u95F4\u3002"
    audioClip: {fileID: 0}
  - text: "\u4E0D\u662F\u753B\u9762\uFF0C\u662F\u611F\u89C9\u3002\u88AB\u5305\u56F4\uFF0C\u88AB\u627F\u8F7D\uFF0C\u88AB\u8FDE\u63A5\u5230\u67D0\u4E2A\u66F4\u5927\u7684\u4E1C\u897F\u3002"
    audioClip: {fileID: 0}
  - text: "\u96E8\u8FDE\u63A5\u4E86\u5929\u7A7A\u548C\u5730\u9762\uFF0C\u8FDE\u63A5\u4E86\u7A97\u5916\u548C\u7A97\u5185\uFF0C\u8FDE\u63A5\u4E86\u4ED6\u548C\u2014\u2014"
    audioClip: {fileID: 0}
  - text: "\u90A3\u4E2A\u58F0\u97F3\u3002"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
