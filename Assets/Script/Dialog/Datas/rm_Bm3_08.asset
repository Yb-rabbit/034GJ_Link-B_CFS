  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm3_08
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u4ED6\u5F2F\u4E0B\u8170\uFF0C\u624B\u843D\u5728\u732B\u7684\u80CC\u4E0A\u3002\u6BDB\u662F\u771F\u8F6F\uFF0C\u8F6F\u5F97\u4E0D\u50CF\u771F\u7684\u3002"
    audioClip: {fileID: 8300000, guid: ed059b04c9dc09d4bb9c11b17d1f7876, type: 3}
  - text: "\u90A3\u732B\u987A\u52BF\u5F80\u4ED6\u624B\u5FC3\u91CC\u62F1\uFF0C\u5589\u5499\u91CC\u6EDA\u51FA\u4E00\u4E32\u5495\u565C\u5495\u565C\u7684\u58F0\u97F3\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u55EF\uFF0C\u4F60\u4E5F\u6765\u4E86\u3002\u201D\u4ED6\u8BF4\u3002\u732B\u6CA1\u62AC\u5934\uFF0C\u5C3E\u5DF4\u5728\u4ED6\u5C0F\u817F\u4E0A\u7ED5\u4E86\u4E00\u5708\u3002"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u8FD9\u91CC\u771F\u7F8E\uFF0C\u627E\u4E2A\u5730\u65B9\u62CD\u5F20\u7167\u5427\u3002"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
