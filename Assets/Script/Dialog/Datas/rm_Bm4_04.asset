%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm4_04
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u201C\u4F60\u997F\u4E0D\u997F\uFF1F\u4E00\u4F1A\u60F3\u5403\u70B9\u4EC0\u4E48\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: 5499a2fd834d444458248fa290d6e12d, type: 3}
  - text: "\u4ED6\u53C8\u5F20\u4E86\u5F20\u5634\u3002"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u522B\u6015\uFF0C\u6211\u5C31\u5728\u8FD9\u5462\u3002\u201D"
    audioClip: {fileID: 8300000, guid: 70e95655c15305242bc9e1c59562a524, type: 3}
  - text: "\u5979\u628A\u624B\u843D\u5728\u4ED6\u624B\u80CC\u4E0A\uFF0C\u4ED6\u611F\u53D7\u5230\u90A3\u53EA\u624B\uFF0C\u5C3D\u7BA1\u6BD4\u8F83\u7626\u5F31\u3002"
    audioClip: {fileID: 0}
  - text: "\u4F46\u6696\u6696\u7684\uFF0C\u8F6F\u7EF5\u7EF5\u7684\uFF0C\u4EE4\u4EBA\u5B89\u5FC3\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u4EC0\u4E48\u53EB\u505A\u6211\u662F\u4E2A\u65B9\u5757\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: 140017a27497a71419c26a61c1179a77, type: 3}
  - text: "\u201C\u505C\u505C\u505C\uFF0C\u4F60\u518D\u8BF4\u4E00\u904D\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: 60cc0adb68c573649b2328286d99c4ee, type: 3}
  - text: "\u201C\u5BF9\u4E0D\u2026\u2026\u8D77\u2026\u2026\u6211\u6CA1\u6709\u2026\u2026\u5F00\u73A9\u7B11\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u51E0\u5929\u8FC7\u53BB\uFF0C\u8BDD\u90FD\u8BF4\u4E0D\u5229\u7D22\u4E86\u3002\u7A7A\u7559\u4E2A\u597D\u80DA\u5B50\uFF0C\u54CE\u5440\u2026\u2026\u25A0\u25A0\uFF01\u201D"
    audioClip: {fileID: 8300000, guid: 05ddfdfafb2b8f4418f053306c926f09, type: 3}
  - text: "\u201C\u6211\u624D\u4E0D\u662F\u2026\u2026\u54D1\u5DF4\u2026\u2026\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u786E\u5B9E\u3002\u54D1\u5DF4\u88AB\u903C\u6025\u4E86\u4F1A\u54AC\u4EBA\u3002"
    audioClip: {fileID: 0}
  - text: "\u25A0  \u25A0  \u25A0\u25A0\u2026\u2026"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u597D\u5566\uFF0C\u6211\u4E0D\u9017\u4F60\u73A9\u4E86\u3002\u8FD9\u662F\u4F60\u4E0A\u6B21\u8981\u7684\u7CD6\u679C\uFF0C\u51FA\u95E8\u53EF\u522B\u88AB\u5C0F\u72D0\u72F8\u52FE\u8D70\u54AF\u3002\u201D"
    audioClip: {fileID: 8300000, guid: b19a917dcef890c46a5945093cfe3408, type: 3}
  - text: "\u4ED6\u4F4E\u5934\u770B\u7740\u90A3\u53EA\u624B\uFF0C\u90A3\u53EA\u624B\u5728\u7684\u5730\u65B9\uFF0C\u4E16\u754C\u8FD8\u662F\u6E05\u695A\u7684\u3002 "
    audioClip: {fileID: 0}
  - text: "\u201C\u563F\u563F\uFF0C\u7231\u4F60\u3002\u201D"
    audioClip: {fileID: 8300000, guid: b8f31be6de6e2b14ea3199702c4d829f, type: 3}
  - text: "\u624B\u4EE5\u5916\u7684\u5730\u65B9\uFF0C\u90FD\u5728\u5F80\u540E\u9000\u3002 "
    audioClip: {fileID: 0}
