%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm3_01
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u57CE\u4E2D\u5FC3\u5728\u508D\u665A\u7684\u65F6\u5019\u4EBA\u6700\u591A\u3002"
    audioClip: {fileID: 0}
  - text: "\u4EBA\u4EEC\u660E\u9762\u4E0A\uFF0C\u6216\u8005\u51D1\u5DE7\u5730\u5728\u540C\u4E00\u65F6\u95F4\u8D70\u51FA\u4E86\u81EA\u5DF1\u7684\u5355\u4F4D\u3002"
    audioClip: {fileID: 0}
  - text: "\u62CE\u7740\u83DC\u7684\uFF0C\u7275\u7740\u72D7\u7684\uFF0C\u5E76\u7740\u80A9\u4F4E\u5934\u770B\u624B\u673A\u7684\u2026\u2026"
    audioClip: {fileID: 0}
  - text: "\u4ED6\u4EEC\u603B\u662F\u5FC3\u65E0\u65C1\u9A9B\u5730\u524D\u5F80\u81EA\u5DF1\u7684\u76EE\u7684\u5730\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u5582\uFF1F\u542C\u5F97\u5230\u5417\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: 94b0a4c189b6b3d4680ac78a3d375f81, type: 3}
  - text: "\u201C\u554A\u2026\u2026\u6211\u5728\uFF0C\u6211\u542C\u7740\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u4EBA\u6D41\u4ECE\u4ED6\u4EEC\u8EAB\u8FB9\u64E6\u8FC7\u53BB\uFF0C\u4E00\u6CE2\u4E00\u6CE2\u7684\uFF0C\u50CF\u6F6E\u6C34\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u5728\u53D1\u4EC0\u4E48\u5446\u5462\uFF1F\u8D70\u5427\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: 036c9c2da34fdb54babc09935debbc69, type: 3}
  - text: "\u4ED6\u88AB\u4EBA\u649E\u4E86\u4E00\u4E0B\u80A9\u8180\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u54CE\u3002\u5BF9\u4E0D\u8D77\u554A\u2014\u2014\u201D\u90A3\u4EBA\u4F3C\u4E4E\u5F88\u6025\uFF0C\u9053\u6B49\u65F6\u5934\u4E5F\u6CA1\u56DE\u3002"
    audioClip: {fileID: 8300000, guid: 05dd6b931d2cd364c969f6e605325685, type: 3}
  - text: "\u201C\u6CA1\u4E8B\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u90A3\u4EBA\u8D70\u8FDC\u4E86\uFF0C\u8BA4\u4E0D\u51FA\u6765\u3002"
    audioClip: {fileID: 0}
  - text: "\u65C1\u8FB9\u7B11\u4E86\u4E00\u58F0\u3002\u8FD9\u5012\u662F\u5F88\u6E05\u695A\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u7B11\u4EC0\u4E48\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u6CA1\u4EC0\u4E48\u5566\u3002\u201D"
    audioClip: {fileID: 8300000, guid: f060ddbea078d4a439d6f5fe78af22f0, type: 3}
  - text: "\u201C\u5C31\u662F\u89C9\u5F97\u2026\u2026\u4F60\u813E\u6C14\u53D8\u597D\u4E86\u3002\u201D"
    audioClip: {fileID: 8300000, guid: 598e520cf51187a498b246c42980ad27, type: 3}
  - text: "\u201C\u6211\u4EE5\u524D\u813E\u6C14\u4E0D\u597D\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u5979\u6545\u610F\u4E0D\u8BF4\u8BDD\uFF0C\u53EA\u5F80\u4EBA\u7FA4\u91CC\u94BB\u3002"
    audioClip: {fileID: 0}
  - text: "\u518D\u4E0D\u8DDF\u4E0A\u5C31\u5B8C\u86CB\u4E86\u3002"
    audioClip: {fileID: 0}
  - text: "\u5E94\u8BE5\u8D70\u54EA\u4E00\u8FB9\u5462\uFF1F"
    audioClip: {fileID: 8300000, guid: 04d8a4f8182c4224ab71b46fd46877da, type: 3}
  - text: "(\u4E5F\u8BB8\u8FD9\u4E2A\u9ED1\u8272\u65B9\u5757\u80FD\u5E2E\u4E0A\u5FD9)"
    audioClip: {fileID: 0}
