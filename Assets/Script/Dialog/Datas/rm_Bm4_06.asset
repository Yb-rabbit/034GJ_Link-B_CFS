%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm4_06
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u75C5\u5E8A\u8FB9\u6709\u4E00\u4E2A\u9ED1\u8272\u7684\u65B9\u5757\uFF0C\u4E0D\u5927\uFF0C\u5C31\u90A3\u4E48\u6F02\u7740\uFF0C\u4E5F\u4E0D\u53D1\u51FA\u4EFB\u4F55\u58F0\u97F3\u3002"
    audioClip: {fileID: 0}
  - text: "\u62A4\u58EB\u8FDB\u6765\u7684\u65F6\u5019\u770B\u4E00\u773C\uFF0C\u5B83\u6CA1\u7BA1\u3002"
    audioClip: {fileID: 0}
  - text: "\u533B\u751F\u8FDB\u6765\u7684\u65F6\u5019\u4E5F\u770B\u4E00\u773C\uFF0C\u5B83\u4E5F\u6CA1\u7BA1\u3002"
    audioClip: {fileID: 0}
  - text: "\u5076\u5C14\u6709\u4EBA\u6765\u63A2\u75C5\uFF0C\u6709\u4EBA\u5750\u5728\u5E8A\u8FB9\u8BF4\u8BDD\uFF0C\u6709\u4EBA\u63E1\u4F4F\u90A3\u53EA\u624B\uFF0C\u6709\u4EBA\u8D77\u8EAB\u79BB\u5F00\u3002"
    audioClip: {fileID: 0}
  - text: "\u9ED1\u8272\u65B9\u5757\u4E00\u76F4\u5728\u90A3\u513F\uFF0C\u6709\u65F6\u5019\u5B83\u4F1A\u52A8\u4E00\u4E0B\uFF0C\u5C31\u4E00\u4E0B\u3002"
    audioClip: {fileID: 0}
  - text: "\u6BD4\u5982\uFF0C\u6709\u4E9B\u8BB8\u9633\u5149\u4ECE\u7A97\u5E18\u7684\u7F1D\u9699\u91CC\u6F0F\u8FDB\u6765\uFF0C\u5728\u5E8A\u811A\u6643\u6210\u4E00\u5C0F\u7247\u5149\u6591\u7684\u65F6\u5019\u3002"
    audioClip: {fileID: 0}
  - text: "\u6BD4\u5982\uFF0C\u5F53\u7A97\u5916\u6709\u98CE\u5439\u8FC7\uFF0C\u5439\u5F97\u4EC0\u4E48\u4E1C\u897F\u8F7B\u8F7B\u54CD\u4E86\u4E00\u4E0B\u7684\u65F6\u5019\u3002"
    audioClip: {fileID: 0}
  - text: "\u6BD4\u5982\uFF0C\u5F53\u6709\u4EBA\u63A8\u95E8\u8FDB\u6765\uFF0C\u811A\u6B65\u58F0\u843D\u5728\u8033\u8FB9\u7684\u65F6\u5019\u3002 "
    audioClip: {fileID: 0}
  - text: "\u5C31\u52A8\u4E00\u4E0B\u3002"
    audioClip: {fileID: 0}
  - text: "\u7136\u540E\u7EE7\u7EED\u5728\u90A3\u513F\uFF0C\u6F02\u6D6E\uFF0C\u9ED8\u4E0D\u4F5C\u58F0\u3002\u50CF\u662F\u5B88\u7740\u4EC0\u4E48\u3002 "
    audioClip: {fileID: 0}
  - text: "\u4E16\u754C\uFF0C\u5B8C\u5168\u6A21\u7CCA\u3002"
    audioClip: {fileID: 0}
  - text: "\u4F46\u58F0\u97F3\u8FD8\u5728\uFF0C\u4E00\u5207\u4E5F\u90FD\u8FD8\u5728\u3002"
    audioClip: {fileID: 0}
  - text: "\u4ED6\u5BF9\u6B64\u611F\u5230\u8FF7\u832B\u3002"
    audioClip: {fileID: 0}
  - text: "\u201C\u4E3A\u4EC0\u4E48\uFF1F\u201D\u4ED6\u60F3\u4E0D\u660E\u767D\u3002"
    audioClip: {fileID: 0}
  - text: "\u4ED6\u5DF2\u7136\u6210\u4E86\u6240\u8C13\u7684\u54D1\u5DF4\uFF0C\u58F0\u97F3\u6C99\u6C99\uFF0C\u4F46\u60C5\u51B5\u65F6\u6709\u597D\u8F6C\u3002"
    audioClip: {fileID: 0}
  - text: "\u5C3D\u7BA1\u4ED6\u5C06\u9762\u5BF9\u7684\uFF0C\u90FD\u662F\u4E00\u7FA4\u7070\u8272\u7684\u65B9\u5757\uFF0C\u4ED6\u8FD8\u662F\u5C1D\u8BD5\u7740\uFF0C\u53BB\u56DE\u5E94\u3002"
    audioClip: {fileID: 0}
  - text: "\u6216\u8BB8\uFF0C\u8FD9\u662F\u4E16\u754C\u7ED9\u4ED6\u6700\u540E\u7684\uFF0C\u8FDE\u63A5\u3002"
    audioClip: {fileID: 0}
