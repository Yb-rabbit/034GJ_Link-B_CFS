  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm4_05
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u6765\u7535\u4EBA\uFF1A\u8389\u5A1C\n\u662F\u5426\u63A5\u542C\uFF1F"
    audioClip: {fileID: 8300000, guid: 68e693a0d2fdcf146b20213b4ca8a564, type: 3}
  - text: "\u201C\u5582\uFF0C\u542C\u5F97\u5230\u5417\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: 94b0a4c189b6b3d4680ac78a3d375f81, type: 3}
  - text: "\u201C\u600E\u4E48\u4E86\uFF0C\u6211\u6709\u5FD8\u5E26\u4E1C\u897F\u5417\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u4F60\u56DE\u6765\u7684\u65F6\u5019\uFF0C\u8BB0\u5F97\u628A\u53E3\u888B\u91CC\u90A3\u5F20\u4F20\u5355\u4E22\u6389\u3002\u201D"
    audioClip: {fileID: 8300000, guid: bf42a5209a34e624caf0ff417af10a46, type: 3}
  - text: "\u201C\u54CE\u5440\uFF0C\u4E00\u5F20\u4F20\u5355\u7F62\u4E86\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u90A3\u4E2A\u8DEF\u53E3\u65C1\u7684\u6BCF\u5BB6\u5E97\u90FD\u6709\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u4E0D\u8BB8\u518D\u62FF\uFF0C\u542C\u5230\u6CA1\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: 2d4fa4e4c8334574c8d10e7eb442c6bb, type: 3}
  - text: "\u201C\u597D\u597D\u597D\uFF0C\u6211\u77E5\u9053\u4E86\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u8FD8\u770B\u5F97\u89C1\u4F20\u5355\uFF0C\u90A3\u4E5F\u4E0D\u7B97\u574F\u4E8B\u3002"
    audioClip: {fileID: 0}
