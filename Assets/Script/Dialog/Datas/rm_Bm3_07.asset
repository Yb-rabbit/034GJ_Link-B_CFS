  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm3_07
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u9633\u5149\u4ECE\u68A7\u6850\u53F6\u7684\u7F1D\u9699\u91CC\u6F0F\u4E0B\u6765\uFF0C\u5728\u5730\u4E0A\u6643\u6210\u4E00\u7247\u4E00\u7247\u7684\u5149\u6591\u3002"
    audioClip: {fileID: 0}
  - text: "\u5149\u5C31\u662F\u5149\uFF0C\u6643\u5C31\u662F\u6643\uFF0C\u5B83\u4EEC\u9075\u5FAA\u7740\u4E00\u5B9A\u7684\u9891\u7387\uFF0C\u548C\u8C10\u800C\u65E0\u6B62\u5730\u65CB\u8F6C\u3002"
    audioClip: {fileID: 0}
  - text: "\u811A\u8FB9\u7684\u52A8\u9759\u7A81\u7136\u6253\u7834\u4E86\u8FD9\u4EFD\u548C\u8C10\u3002
      \u90A3\u53EA\u6A58\u732B\u4E0D\u77E5\u9053\u4EC0\u4E48\u65F6\u5019\u6765\u7684\uFF0C\u6B63\u7528\u8111\u888B\u9876\u4ED6\u7684\u88E4\u817F\u3002"
    audioClip: {fileID: 0}
  - text: "\u4E00\u4E0B\uFF0C\u4E24\u4E0B\uFF0C \u50CF\u5728\u786E\u8BA4\u4EC0\u4E48\u3002"
    audioClip: {fileID: 0}
