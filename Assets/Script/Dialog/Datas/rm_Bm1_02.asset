  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm1_02
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "(\u5BF9\u8BDD\u65F6\u8BF7\u4FDD\u6301\u9F20\u6807\u63A7\u5236)"
    audioClip: {fileID: 8300000, guid: fc3941dc150329d498d86e2254ce6afe, type: 3}
  - text: "\u201C\u5B9E\u5728\u4E0D\u597D\u610F\u601D\uFF0C\u6362\u5B63\u611F\u5192\u4E86\u3002\u201D"
    audioClip: {fileID: 8300000, guid: eb94a12c1a53f9845bb08abe419f72b1, type: 3}
  - text: "\u201C\u6CA1\u5173\u7CFB\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u5BF9\u65B9\u7684\u7535\u8BDD\u58F0\u6253\u65AD\u4E86\u4EA4\u8C08\u3002"
    audioClip: {fileID: 8300000, guid: 68e693a0d2fdcf146b20213b4ca8a564, type: 3}
  - text: "\u8BCA\u5BA4\u7684\u95E8\u5F00\u4E86\u3002"
    audioClip: {fileID: 8300000, guid: 584c50d3a0df4aa44bbd62cd8d68fba8, type: 3}
  - text: "\u201C080021 \u5E03\u6717\u5148\u751F\uFF0C\u8BF7\u5230\u8BCA\u5BA4\u6765\u3002\u201D"
    audioClip: {fileID: 8300000, guid: c76aa89d71232b44eb7cae4a0957e567, type: 3}
  - text: "\u201C\u5662\u3002\u6211\u8FD9\u5C31\u6765\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u95E8\u53C8\u88AB\u5173\u4E0A\u3002"
    audioClip: {fileID: 8300000, guid: 0902066c73ff66741b3430453ab78c8d, type: 3}
  - text: "\u7EE7\u7EED\u5F80\u524D\u8D70\u5427\u3002"
    audioClip: {fileID: 8300000, guid: 474553d6ae04c4240a0ac8d03b963dce, type: 3}
