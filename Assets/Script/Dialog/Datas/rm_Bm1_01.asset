  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm1_01
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u201C\u677E\u677E\u624B\u8155\uFF0C\u653E\u8F7B\u677E\u3002\u201D"
    audioClip: {fileID: 8300000, guid: b9a0cc2ac73ecc94db707fb89df8ad90, type: 3}
  - text: "\u201C\u6211\u8FD9\u662F\u5728\u54EA\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u6211\u7A81\u7136\u53D8\u5F97\u597D\u5947\u602A\u3002\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u201C\u522B\u7740\u6025\uFF0C\u6211\u542C\u5F97\u5230\u60A8\u7684\u58F0\u97F3\u3002\u201D"
    audioClip: {fileID: 8300000, guid: aab7c57869fb1d141a0c6c5a8b5bf0a5, type: 3}
  - text: "\u201C\u8BF7A0001\u5230\u4E09\u53F7\u8BCA\u5BA4\u201D"
    audioClip: {fileID: 8300000, guid: 089126b9371fb364e8c0116ff2f71de7, type: 3}
  - text: "\u201C\u597D\u5566\uFF0C\u9EBB\u70E6\u7AD9\u7A33\u5F80\u8FD9\u8FB9\u8D70\uFF0C\u6211\u6276\u7740\u60A8\u3002\u201D"
    audioClip: {fileID: 8300000, guid: 6d93fd3bb71d44643ab04ace50f80eab, type: 3}
  - text: "\u201C\u4E0D\u7528\u4E86\uFF0C\u6211\u8FD8\u80FD\u770B\u5F97\u6E05\u8DEF\u2026\u2026\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "(\u8BF7\u5F80\u5C4F\u5E55\u53F3\u4FA7\u79BB\u5F00)"
    audioClip: {fileID: 8300000, guid: 474553d6ae04c4240a0ac8d03b963dce, type: 3}
