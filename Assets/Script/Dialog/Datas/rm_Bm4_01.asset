  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm4_01
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u5929\u82B1\u677F\u8FD8\u662F\u90A3\u4E2A\u5929\u82B1\u677F\uFF0C\u7A97\u5E18\u8FD8\u662F\u90A3\u4E2A\u7A97\u5E18\uFF0C\u5E8A\u5934\u67DC\u8FD8\u662F\u90A3\u4E2A\u5E8A\u5934\u67DC\u3002"
    audioClip: {fileID: 0}
  - text: "\u4E00\u5207\uFF0C\u770B\u8D77\u6765\u90FD\u662F\u7167\u65E7\u3002\u4F46\u6240\u6709\u7684\u4E1C\u897F\u90FD\u5F80\u540E\u9000\u4E86\u4E00\u70B9\uFF0C\u50CF\u662F\u9694\u7740\u4EC0\u4E48\u5728\u770B\u3002"
    audioClip: {fileID: 0}
  - text: "\u4ED6\u5750\u8D77\u6765\uFF0C\u53EB\u4E86\u4E00\u58F0\u5979\u7684\u540D\u5B57\u3002\u58F0\u97F3\u843D\u4E0B\u53BB\uFF0C\u6CA1\u6709\u56DE\u97F3\u3002"
    audioClip: {fileID: 0}
  - text: "\u5979\u53C8\u4E0D\u5728\uFF0C\u53EF\u80FD\u53BB\u4E70\u83DC\u4E86\uFF0C\u53EF\u80FD\u5728\u53A8\u623F\uFF0C\u5728\u522B\u7684\u623F\u95F4\u3002 "
    audioClip: {fileID: 0}
  - text: "\u4ED6\u53C8\u53EB\u4E86\u4E00\u58F0\u2014\u2014"
    audioClip: {fileID: 0}
