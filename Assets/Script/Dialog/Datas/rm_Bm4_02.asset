  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm4_02
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u5979\u53C8\u4E0D\u5728\uFF0C\u53EF\u80FD\u53BB\u4E70\u83DC\u4E86\uFF0C\u53EF\u80FD\u5728\u53A8\u623F\uFF0C\u53EF\u80FD\u5728\u522B\u7684\u623F\u95F4\u3002
      \u4ED6\u53C8\u53EB\u4E86\u4E00\u58F0\u3002 "
    audioClip: {fileID: 0}
  - text: "\u8FD9\u56DE\u4ED6\u542C\u89C1\u4E86\u2014\u2014\u81EA\u5DF1\u7684\u58F0\u97F3\uFF0C\u50CF\u662F\u4ECE\u5F88\u8FDC\u7684\u5730\u65B9\u4F20\u8FC7\u6765\u7684\uFF0C\u95F7\u95F7\u7684\uFF0C\u6C89\u6C89\u7684\uFF0C\u50CF\u9694\u7740\u4E00\u5C42\u6C34\u3002"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u4ED6\u5750\u5728\u5E8A\u8FB9\uFF0C\u7A97\u5E18\u88AB\u98CE\u5439\u8D77\u6765\uFF0C\u53C8\u843D\u4E0B\u53BB\uFF0C\u98CE\u8D81\u673A\u4ECE\u7A97\u6237\u7F1D\u91CC\u6324\u8FDB\u6765\uFF0C\u9001\u6765\u4E00\u4E1D\u51C9\u610F\u3002"
    audioClip: {fileID: 0}
  - text: "\u4ED6\u60F3\uFF0C\u662F\u4E0D\u662F\u8BE5\u53BB\u627E\u627E\u5979\u4E86\u3002
      \u4F46\u4ED6\u6CA1\u52A8\uFF0C\u5012\u4E0D\u662F\u56E0\u4E3A\u4E0D\u60F3\u52A8\u3002"
    audioClip: {fileID: 0}
  - text: "\u662F\u56E0\u4E3A\u4ED6\u4E0D\u592A\u786E\u5B9A\uFF0C\u81EA\u5DF1\u662F\u4E0D\u662F\u771F\u7684\u7AD9\u5F97\u8D77\u6765\u3002"
    audioClip: {fileID: 0}
