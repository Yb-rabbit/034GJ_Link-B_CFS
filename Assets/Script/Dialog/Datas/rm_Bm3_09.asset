  m_Script: {fileID: 11500000, guid: fe6c885d4dbb6124fab951276d220488, type: 3}
  m_Name: rm_Bm3_09
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u4ED6\u4F4E\u4E0B\u5934\uFF0C\u770B\u7740\u732B\uFF0C\u732B\u4E5F\u770B\u7740\u4ED6\u3002"
    audioClip: {fileID: 0}
  - text: " \u201C\u4F60\u8BF4\uFF0C\u201D\u4ED6\u7684\u58F0\u97F3\u5F88\u8F7B\uFF0C\u201C\u6211\u8981\u662F\u4E0D\u8BB0\u5F97\u4F60\u4E86\uFF0C\u4F60\u8FD8\u4F1A\u6765\u770B\u6211\u5417\uFF1F\u201D"
    audioClip: {fileID: 8300000, guid: d9750e081782a7549b3c80a7d42e0f22, type: 3}
  - text: "\u732B\u4E0D\u7406\u89E3\u4ED6\u6240\u8BF4\u7684\uFF0C\u53EA\u77E5\u9053\u7EE7\u7EED\u8E6D\u4ED6\u7684\u624B\u3002
      \u4ED6\u7B11\u4E86\u4E00\u4E0B\uFF0C\u7B97\u4E86\u3002"
    audioClip: {fileID: 0}
  - text: "\u4EC0\u4E48\u90FD\u4E0D\u7528\u8BB0\u4F4F\uFF0C\u53EA\u8981\u5C06\u65F6\u5149\u5B9A\u683C\u5728\u8FD9\u7247\u516C\u56ED\u7684\u4E00\u9685\uFF0C\u4FBF\u597D\u3002"
    audioClip: {fileID: 0}
